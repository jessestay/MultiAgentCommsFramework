# Slack — Bot Token (xoxb-...) from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack — Signing Secret from Basic Information
SLACK_SIGNING_SECRET=your-signing-secret-here

# Slack — App-Level Token (xapp-...) from Basic Information > App-Level Tokens
# Requires connections:write scope. This is what enables Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AI backend — unset (default) uses the Anthropic API directly.
# Set to 'litellm' to use local models via LiteLLM → Ollama on 127.0.0.1:4000
# (see litellm-config.yaml). No automatic fallback to a paid API.
# AI_BACKEND=litellm
# LITELLM_QUICK_MODEL=quick
# LITELLM_SMART_MODEL=smart
# LITELLM_BEST_MODEL=best

# GitHub — Personal Access Token (read:repo scope is enough)
GITHUB_TOKEN=ghp-your-token-here

# Vikunja — task management (see SETUP.md Part 5)
# Until these are set, task tracking is a silent no-op.
VIKUNJA_URL=https://tasks.yourdomain.com
VIKUNJA_PROJECT_ID=3
# Shared fallback token (Settings → API Tokens in Vikunja)
VIKUNJA_TOKEN=tk_your_shared_token_here
# Per-agent tokens (recommended; each falls back to VIKUNJA_TOKEN)
# VIKUNJA_TOKEN_EXECPM=tk_...
# VIKUNJA_TOKEN_CMO=tk_...
# Per-agent Vikunja user IDs (Administration → Users)
# VIKUNJA_USER_EXECPM=1
# VIKUNJA_USER_CMO=2

# Optional: Upstash Redis URL (if you want cloud state instead of local JSON)
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your-token-here

# Environment
NODE_ENV=production
