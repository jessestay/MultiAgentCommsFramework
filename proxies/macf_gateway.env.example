# MACF LiteLLM Gateway -- Provider Credentials Template
# =============================================================================
# Copy this file to macf_gateway.env and fill in your keys.
# NEVER commit macf_gateway.env to git (it contains secrets).
#
# The gateway (proxies/litellm_config.yaml) reads these via os.environ/...,
# loaded by deploy_model_router.ps1 before launch. Setting Windows env vars
# alone is NOT sufficient -- the deploy script must load this file.
# =============================================================================

# Gateway auth (required). Generate with: python -c "import secrets; print(secrets.token_hex(20))"
LITELLM_MASTER_KEY=PASTE_GENERATED_KEY_HERE

# Local model (Ollama). No key needed.
OLLAMA_URL=http://127.0.0.1:11434

# OpenRouter (tier 3). Get a key at https://openrouter.ai/keys
# Free-tier models work with $0 balance; add credits for paid models.
OPENROUTER_API_KEY=

# Meta Muse API (tier 4, direct). Create at https://dev.meta.ai
META_API_KEY=

# Google Gemini API (tier 4, direct). Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude API (tier 4, direct). Create at https://console.anthropic.com/
ANTHROPIC_API_KEY=
